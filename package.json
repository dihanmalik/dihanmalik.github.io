{
  "name": "Nahid Abdulmalik",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://dihanmalik.github.io",
  "scripts": {
    "dev": "vite",
    "validate:client-env": "node src/field-manual-portfolio/game/validate-client-env.mjs",
    "build": "pnpm run validate:client-env && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "pnpm run start:backend",
    "start:backend": "node src/field-manual-portfolio/game/backend/server.mjs",
    "build:backend": "pnpm --dir src/field-manual-portfolio/game/backend run build",
    "deploy:api": "railway up src/field-manual-portfolio/game/backend --path-as-root",
    "postdeploy": "pnpm run validate:client-env --require-production-url && pnpm run deploy:api && pnpm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@railway/cli": "^5.30.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": "26.x"
  }
}
